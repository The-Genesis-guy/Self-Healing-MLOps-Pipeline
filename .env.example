# Example environment variables for GUARDIAN
# Copy to .env and edit for your environment

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173

# App metadata
APP_TITLE=GUARDIAN Pipeline API
APP_VERSION=1.0.0

# Secret placeholder (for production use secret manager)
SECRET_KEY=replace-me-with-secure-random

# Runtime
PORT=8000
ENV=development
